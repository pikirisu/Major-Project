# Whitelist: ignore everything in the root, then let through only what the
# repo needs. Anything new stays local until it is added below on purpose,
# so the 5.4 GB dataset and the 247 MB feature cache can never be pushed by accident.
/*

!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/leak_check.py
!/lr_check.py
!/docs/

# notebooks, in the order they are run
!/build_cache.ipynb
!/GAT_ds004504.ipynb
!/GCN_ds004504.ipynb
!/RF_ds004504.ipynb
!/GAT_nograph_ds004504.ipynb
!/GAT_window_ds004504.ipynb
!/GAT_multiclass_ds004504.ipynb
!/GATv2_ds004504.ipynb
!/GATv2gate_ds004504.ipynb
!/build_cache_ds006036.ipynb
!/GAT_ds006036.ipynb
!/build_fc_graphs.ipynb
!/GAT_multiclass_pearson_ds004504.ipynb
!/GAT_multiclass_plv_ds004504.ipynb
!/GAT_multiclass_aec_ds004504.ipynb
!/GAT_multiclass_granger_ds004504.ipynb
!/GAT_dementia_ds004504.ipynb
!/Final_scoreboard_ds004504.ipynb
!/Combine_ds004504.ipynb

# saved results (small: JSON, CSV, PNG, out-of-fold probabilities)
!/results_gat/
!/results_gcn/
!/results_rf/
!/results_gat_nograph/
!/results_gat_window/
!/results_gat_multiclass/
!/results_gatv2/
!/results_gatv2gate/
!/results_gat_ds006036/
!/results_gat_multiclass_pearson/
!/results_gat_multiclass_plv/
!/results_gat_multiclass_aec/
!/results_gat_multiclass_granger/
!/results_gat_dementia/
!/results_final/

# AD vs FTD feature study: its notebooks, the 88-row feature table, its results
!/experiments_ad_vs_ftd/

# the base paper's released code, re-run on held-out patients (cache_released_code/ stays local)
!/experiments_released_code/
!/results_released_code/

# never inside the folders above either
.ipynb_checkpoints/
__pycache__/
*.pt
*.pth
